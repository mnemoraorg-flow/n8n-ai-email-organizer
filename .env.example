# Copy to .env and fill in every value marked CHANGE_ME.
#   cp .env.example .env
#
# .env is gitignored. Never commit real values.

# --- Image versions -------------------------------------------------------
# Pin n8n to a specific stable tag. Check https://docs.n8n.io for the current
# stable release before bumping; n8n runs its database migrations on startup.
N8N_VERSION=2.48.5

# --- Public address -------------------------------------------------------
# DOMAIN_NAME and SUBDOMAIN together decide the URL: n8n.example.com
DOMAIN_NAME=example.com
SUBDOMAIN=n8n
# Leave this line exactly as it is for local testing: Caddy then uses its own
# internal CA. Set it to "true" once DNS points at this server, which makes Caddy
# request a publicly trusted certificate instead.
TLS_ACME=

# --- Secrets --------------------------------------------------------------
# n8n encrypts saved credentials with this key. Generate once and keep it safe:
#   openssl rand -hex 32
# Losing it makes every stored credential unreadable. Changing it does too.
N8N_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# Shared secret between n8n and the task runner container.
#   openssl rand -hex 32
RUNNERS_AUTH_TOKEN=CHANGE_ME_openssl_rand_hex_32

# --- PostgreSQL -----------------------------------------------------------
# These are the superuser credentials used to create the database and the
# non-root role on first boot. Postgres only applies them to an empty volume.
POSTGRES_USER=n8n_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=n8n

# n8n connects as this unprivileged role, not as the superuser above.
POSTGRES_NON_ROOT_USER=n8n
POSTGRES_NON_ROOT_PASSWORD=CHANGE_ME_strong_password

# --- Behaviour ------------------------------------------------------------
# Used for the Schedule Trigger and every timestamp the workflow writes.
GENERIC_TIMEZONE=Asia/Manila

# Your AI provider key, used by the classifier node in the workflow.
# Read inside n8n as {{ $env.OPENAI_API_KEY }}; see workflows/README.md.
OPENAI_API_KEY=CHANGE_ME
